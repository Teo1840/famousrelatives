{
  "manifest_version": 3,
  "name": "Famous Relatives",
  "version": "1.1.1",
  "description": "Encontrá tu parentesco con personas famosas usando tu árbol de FamilySearch.",
  "permissions": ["cookies", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.familysearch.org/*",
    "https://qfptktlmbqgokhizvgdy.supabase.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Famous Relatives",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
